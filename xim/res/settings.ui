<?xml version="1.0" encoding="UTF-8"?>
<!--
  lyyime-xim 设置窗口(GtkBuilder 格式,GTK3,多标签页 GtkNotebook)
  页1 常规:候选数 / 字体大小 / 中文标点 / 词频学习 / 开机自启
  页2 输入:中英混合 / 自动直通 / 四码顶屏 / 四码唯一上屏 / 词组效率提示 /
          精确单字词频排位 / 回车与 Shift 上屏英文后的去向(临时英文 / 切英文模式)
  页3 快捷键:造词 / 截屏(冲突自动避让)/ 快速功能键
  页4 AI 助手:OpenAI 兼容接口(地址/密钥/模型/系统提示/超时 + 测试连接)
  页5 输入统计:停顿显示今日统计(全局数据,显示端=悬浮窗状态行)
  控件 id 与 src/settings.c 一一对应(跨页共用,勿改);按钮行为:
  确定=保存全部页并即时生效,取消=还原。
-->
<interface domain="lyyime">
  <requires lib="gtk+" version="3.10"/>
  <object class="GtkAdjustment" id="adj_page_size">
    <property name="lower">1</property>
    <property name="upper">10</property>
    <property name="step_increment">1</property>
    <property name="page_increment">1</property>
  </object>
  <object class="GtkAdjustment" id="adj_font_size">
    <property name="lower">10</property>
    <property name="upper">28</property>
    <property name="step_increment">1</property>
    <property name="page_increment">2</property>
  </object>
  <object class="GtkAdjustment" id="adj_ai_timeout">
    <property name="lower">5</property>
    <property name="upper">300</property>
    <property name="step_increment">5</property>
    <property name="page_increment">30</property>
  </object>
  <object class="GtkAdjustment" id="adj_stats_pause">
    <property name="lower">3</property>
    <property name="upper">300</property>
    <property name="step_increment">1</property>
    <property name="page_increment">10</property>
  </object>
  <object class="GtkAdjustment" id="adj_stats_idle">
    <property name="lower">5</property>
    <property name="upper">600</property>
    <property name="step_increment">5</property>
    <property name="page_increment">30</property>
  </object>
  <object class="GtkWindow" id="settings_window">
    <property name="title">lyyIme 输入法设置</property>
    <property name="resizable">False</property>
    <property name="border-width">14</property>
    <child>
      <object class="GtkBox" id="root_box">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <child>
          <object class="GtkNotebook" id="notebook">
            <property name="visible">True</property>
            <property name="can-focus">True</property>

            <!-- ===== 页 1:常规 ===== -->
            <child>
              <object class="GtkGrid" id="grid_general">
                <property name="visible">True</property>
                <property name="margin-top">8</property>
                <property name="row-spacing">8</property>
                <property name="column-spacing">12</property>
                <child>
                  <object class="GtkLabel" id="lbl_page">
                    <property name="visible">True</property>
                    <property name="halign">start</property>
                    <property name="label">候选词数</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkSpinButton" id="spin_page_size">
                    <property name="visible">True</property>
                    <property name="adjustment">adj_page_size</property>
                    <property name="numeric">True</property>
                    <property name="width-chars">4</property>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_font">
                    <property name="visible">True</property>
                    <property name="halign">start</property>
                    <property name="label">候选窗字体大小</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">1</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkSpinButton" id="spin_font_size">
                    <property name="visible">True</property>
                    <property name="adjustment">adj_font_size</property>
                    <property name="numeric">True</property>
                    <property name="width-chars">4</property>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">1</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkCheckButton" id="chk_chinese_punct">
                    <property name="visible">True</property>
                    <property name="label">中文标点(中文态输出 ,。?! 等)</property>
                    <property name="halign">start</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">2</property>
                    <property name="width">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkCheckButton" id="chk_learning">
                    <property name="visible">True</property>
                    <property name="label">词频学习(记录上屏习惯并调整排序)</property>
                    <property name="halign">start</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">3</property>
                    <property name="width">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkCheckButton" id="chk_autostart">
                    <property name="visible">True</property>
                    <property name="label">开机自启动(写入 ~/.config/autostart)</property>
                    <property name="halign">start</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">4</property>
                    <property name="width">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_cq_label">
                    <property name="visible">True</property>
                    <property name="halign">start</property>
                    <property name="label">候选右键·自定义查询菜单名</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">5</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkEntry" id="ent_cq_label">
                    <property name="visible">True</property>
                    <property name="width-chars">18</property>
                    <property name="placeholder-text">自定义查询</property>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">5</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_cq_url">
                    <property name="visible">True</property>
                    <property name="halign">start</property>
                    <property name="label">自定义查询网址</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">6</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkEntry" id="ent_cq_url">
                    <property name="visible">True</property>
                    <property name="hexpand">True</property>
                    <property name="width-chars">42</property>
                    <property name="placeholder-text">https://www.baidu.com/s?wd={q}</property>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">6</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_cq_hint">
                    <property name="visible">True</property>
                    <property name="halign">start</property>
                    <property name="label" translatable="yes">网址中 {q} 为候选词占位符;网址留空则右键菜单不显示此项</property>
                    <attributes>
                      <attribute name="scale" value="0.85"/>
                      <attribute name="foreground" value="#777777"/>
                    </attributes>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">7</property>
                    <property name="width">2</property>
                  </packing>
                </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel" id="lbl_tab_general">
                <property name="visible">True</property>
                <property name="label">常规</property>
              </object>
            </child>

            <!-- ===== 页 2:输入 ===== -->
            <child>
              <object class="GtkGrid" id="grid_input">
                <property name="visible">True</property>
                <property name="margin-top">8</property>
                <property name="row-spacing">8</property>
                <property name="column-spacing">12</property>
                <child>
                  <object class="GtkCheckButton" id="chk_mixed_english">
                    <property name="visible">True</property>
                    <property name="label">中英混合(无中文候选时给出英文词)</property>
                    <property name="halign">start</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">0</property>
                    <property name="width">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkCheckButton" id="chk_auto_commit_english">
                    <property name="visible">True</property>
                    <property name="label">英文词自动直通(高置信词遇标点/空格直接上屏)</property>
                    <property name="halign">start</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">1</property>
                    <property name="width">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkCheckButton" id="chk_commit_after_four">
                    <property name="visible">True</property>
                    <property name="label">四码顶屏(满四码后继续输入字母先上屏五笔首选)</property>
                    <property name="halign">start</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">2</property>
                    <property name="width">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkCheckButton" id="chk_commit_unique_four">
                    <property name="visible">True</property>
                    <property name="label">四码唯一上屏(满四码且仅一个候选时免空格直接上屏)</property>
                    <property name="halign">start</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">3</property>
                    <property name="width">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkCheckButton" id="chk_commit_first_at_four">
                    <property name="visible">True</property>
                    <property name="label">四码首选上屏(满四码且候选只此一条直接上屏首选,多候选等选词/顶屏)</property>
                    <property name="halign">start</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">4</property>
                    <property name="width">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkCheckButton" id="chk_phrase_hint">
                    <property name="visible">True</property>
                    <property name="label">词组效率提示(上屏后最近几字有更省键的词组时候选条提示)</property>
                    <property name="halign">start</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">5</property>
                    <property name="width">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkCheckButton" id="chk_exact_freq_rank">
                    <property name="visible">True</property>
                    <property name="label">四码/简码单字按词频排位(低频字让位高频词组,常用字仍在最前)</property>
                    <property name="halign">start</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">6</property>
                    <property name="width">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_enter_en">
                    <property name="visible">True</property>
                    <property name="halign">start</property>
                    <property name="label">回车上屏英文后</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">7</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkComboBoxText" id="combo_enter_en">
                    <property name="visible">True</property>
                    <property name="hexpand">True</property>
                    <items>
                      <item translatable="no">临时英文(默认,保持中文模式)</item>
                      <item translatable="no">切到英文模式(长久英文)</item>
                    </items>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">7</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_shift_en">
                    <property name="visible">True</property>
                    <property name="halign">start</property>
                    <property name="label">Shift 上屏英文后</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">8</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkComboBoxText" id="combo_shift_en">
                    <property name="visible">True</property>
                    <property name="hexpand">True</property>
                    <items>
                      <item translatable="no">临时英文(仅上屏,保持中文)</item>
                      <item translatable="no">切到英文模式(默认,长久英文)</item>
                    </items>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">8</property>
                  </packing>
                </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel" id="lbl_tab_input">
                <property name="visible">True</property>
                <property name="label">输入</property>
              </object>
            </child>

            <!-- ===== 页 3:快捷键 ===== -->
            <child>
              <object class="GtkGrid" id="grid_hotkey">
                <property name="visible">True</property>
                <property name="margin-top">8</property>
                <property name="row-spacing">8</property>
                <property name="column-spacing">12</property>
                <child>
                  <object class="GtkLabel" id="lbl_coin_hotkey">
                    <property name="visible">True</property>
                    <property name="label">造词快捷键:</property>
                    <property name="halign">start</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkEntry" id="ent_coin_hotkey">
                    <property name="visible">True</property>
                    <property name="tooltip-text">上屏汉字后按此键进入造词:方向键 →/↑ 多选一字、←/↓ 少选一字,回车存词,Esc 取消。写法:修饰(ctrl/alt/super/shift,至少一个)+键名,如 ctrl+equal、alt+comma、ctrl+f2。与截屏快捷键冲突时自动 +Alt/+Shift 逐级避让,保存后输入框显示实际生效值</property>
                    <property name="halign">start</property>
                    <property name="width-chars">18</property>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_shot_hotkey">
                    <property name="visible">True</property>
                    <property name="label">截屏快捷键:</property>
                    <property name="halign">start</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">1</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkEntry" id="ent_shot_hotkey">
                    <property name="visible">True</property>
                    <property name="tooltip-text">按下拉起框选截屏:拖拽选区(存图片目录并复制剪贴板),Esc 取消、Enter 确认、双击整屏。写法:修饰(ctrl/alt/super/shift,至少一个)+键名,如 ctrl+alt+a、ctrl+shift+x。与造词快捷键冲突时自动 +Alt/+Shift 逐级避让,保存后输入框显示实际生效值</property>
                    <property name="halign">start</property>
                    <property name="width-chars">18</property>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">1</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkCheckButton" id="chk_quick_actions">
                    <property name="visible">True</property>
                    <property name="label">快速功能键(输入触发词时候选条提示,数字键/鼠标点击执行)</property>
                    <property name="tooltip-text">输入与触发词完全相同的字母时候选条追加功能候选,数字键或鼠标点击即执行,不上屏文本。默认:peizhi/shezhi=设置、jietu=截图(候选注释直接显示截屏热键,执行后也会提示)、bangzhu=帮助。触发词/名称/命令可在 config.toml 的 [[quick_actions]] 块中增删,command 支持 @settings、@shot、@help 或任意 shell 命令</property>
                    <property name="halign">start</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">2</property>
                    <property name="width">2</property>
                  </packing>
                </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel" id="lbl_tab_hotkey">
                <property name="visible">True</property>
                <property name="label">快捷键</property>
              </object>
            </child>

            <!-- ===== 页 4:AI 助手 ===== -->
            <child>
              <object class="GtkGrid" id="grid_ai">
                <property name="visible">True</property>
                <property name="margin-top">8</property>
                <property name="row-spacing">6</property>
                <property name="column-spacing">10</property>
                <child>
                  <object class="GtkCheckButton" id="chk_ai_enabled">
                    <property name="visible">True</property>
                    <property name="label">启用 AI 助手(中文态输入 /AI+提示词,回车调用大模型;需兼容 OpenAI 接口的服务:DeepSeek/千问/智谱/Ollama 等)</property>
                    <property name="halign">start</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">0</property>
                    <property name="width">3</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_ai_base">
                    <property name="visible">True</property>
                    <property name="halign">start</property>
                    <property name="label">API 地址</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">1</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkEntry" id="ent_ai_base">
                    <property name="visible">True</property>
                    <property name="width-chars">34</property>
                    <property name="placeholder-text">https://api.deepseek.com/v1</property>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">1</property>
                    <property name="width">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_ai_key">
                    <property name="visible">True</property>
                    <property name="halign">start</property>
                    <property name="label">API 密钥</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkEntry" id="ent_ai_key">
                    <property name="visible">True</property>
                    <property name="width-chars">34</property>
                    <property name="placeholder-text">sk-…(本地服务如 Ollama 可留空)</property>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">2</property>
                    <property name="width">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_ai_model">
                    <property name="visible">True</property>
                    <property name="halign">start</property>
                    <property name="label">模型名</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">3</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkEntry" id="ent_ai_model">
                    <property name="visible">True</property>
                    <property name="width-chars">34</property>
                    <property name="placeholder-text">如 deepseek-chat / qwen-plus / glm-4 / llama3</property>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">3</property>
                    <property name="width">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_ai_prompt">
                    <property name="visible">True</property>
                    <property name="halign">start</property>
                    <property name="label">系统提示</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">4</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkEntry" id="ent_ai_prompt">
                    <property name="visible">True</property>
                    <property name="width-chars">34</property>
                    <property name="placeholder-text">可选;留空使用内置"直接输出结果本体"</property>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">4</property>
                    <property name="width">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_ai_timeout">
                    <property name="visible">True</property>
                    <property name="halign">start</property>
                    <property name="label">超时(秒)</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">5</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkSpinButton" id="spin_ai_timeout">
                    <property name="visible">True</property>
                    <property name="adjustment">adj_ai_timeout</property>
                    <property name="numeric">True</property>
                    <property name="width-chars">4</property>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">5</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkButton" id="btn_ai_test">
                    <property name="visible">True</property>
                    <property name="label">测试连接(先保存再测试)</property>
                    <property name="halign">end</property>
                  </object>
                  <packing>
                    <property name="left-attach">2</property>
                    <property name="top-attach">5</property>
                  </packing>
                </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel" id="lbl_tab_ai">
                <property name="visible">True</property>
                <property name="label">AI 助手</property>
              </object>
            </child>

            <!-- ===== 页 5:输入统计 ===== -->
            <child>
              <object class="GtkGrid" id="grid_stats">
                <property name="visible">True</property>
                <property name="margin-top">8</property>
                <property name="row-spacing">8</property>
                <property name="column-spacing">12</property>
                <child>
                  <object class="GtkCheckButton" id="chk_stats_enabled">
                    <property name="visible">True</property>
                    <property name="label">启用输入统计(打字停顿后在悬浮窗状态行显示今日字数与速度)</property>
                    <property name="halign">start</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">0</property>
                    <property name="width">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_stats_pause">
                    <property name="visible">True</property>
                    <property name="halign">start</property>
                    <property name="label">停顿多少秒后显示</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">1</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkSpinButton" id="spin_stats_pause">
                    <property name="visible">True</property>
                    <property name="adjustment">adj_stats_pause</property>
                    <property name="numeric">True</property>
                    <property name="width-chars">5</property>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">1</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_stats_idle">
                    <property name="visible">True</property>
                    <property name="halign">start</property>
                    <property name="label">计入速度的最长停顿(秒)</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkSpinButton" id="spin_stats_idle">
                    <property name="visible">True</property>
                    <property name="adjustment">adj_stats_idle</property>
                    <property name="numeric">True</property>
                    <property name="width-chars">5</property>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_stats_hint">
                    <property name="visible">True</property>
                    <property name="halign">start</property>
                    <property name="label">统计为全局数据(~/.local/share/lyyime/stats/),各输入模式共用同一份;
速度 = 今日字数 ÷ 活跃打字时长,超过「最长停顿」的空隙(思考、离开)不计入时长。
保存后悬浮窗即时生效,无需重启。</property>
                    <property name="valign">start</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">3</property>
                    <property name="width">2</property>
                  </packing>
                </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel" id="lbl_tab_stats">
                <property name="visible">True</property>
                <property name="label">输入统计</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkButtonBox" id="btnbox">
            <property name="visible">True</property>
            <property name="layout-style">end</property>
            <property name="spacing">8</property>
            <child>
              <object class="GtkButton" id="btn_cancel">
                <property name="visible">True</property>
                <property name="label">取消</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">False</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="btn_ok">
                <property name="visible">True</property>
                <property name="label">确定</property>
                <property name="can-default">True</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">False</property>
                <property name="position">1</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">False</property>
            <property name="position">1</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
</interface>
